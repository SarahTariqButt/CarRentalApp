
@model List<CarRentalApp.Models.Car>

<h1 class="mb-2">Available Cars</h1>
<p class="mb-4">Select a car below to book it.</p>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No more cars available.
    </div>
}
else
{
    <div class="container">
        <div class="row">
            @foreach (var cr in Model)
            {
                <div class="col-md-4 col-sm-12 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@cr.Name</h5>

                            <p class="card-text">
                                Price per day: PKR @cr.PricePerDay
                            </p>

                            <span class="badge bg-success">
                                Available
                            </span>

                            <form asp-controller="Cars"
                                  asp-action="Book"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@cr.Id" />

                                <button type="submit"
                                        class="btn btn-primary w-100 mt-3">
                                    Book Car
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
